            </p>
        </div>
        """
        
        QtWidgets.QMessageBox.about(
            self,
            "About PDFgetX3 GUI v2.0",
            about_text
        )
    
    def _get_parameters(self) -> PDFParameters:
        """Get current parameters from UI."""
        dataformat = "QA" if self.format_q.isChecked() else "twotheta"
        
        rebin_mode = "none"
        if self.rebin_linear.isChecked():
            rebin_mode = "linear"
        elif self.rebin_exp.isChecked():
            rebin_mode = "exponential"
        
        return PDFParameters(
            qmin=self.qmin_spin.value(),
            qmax=self.qmax_spin.value(),
            qmaxinst=self.qmaxinst_spin.value(),
            rmin=self.rmin_spin.value(),
            rmax=self.rmax_spin.value(),
            rstep=self.rstep_spin.value(),
            rpoly=self.rpoly_spin.value(),
            bkgscale=self.bkgscale_spin.value(),
            composition=self.composition_edit.text(),
            dataformat=dataformat,
            wavelength=self.wavelength_spin.value(),
            rebin_mode=rebin_mode,
            show_iq=self.plot_iq.isChecked(),
            show_sq=self.plot_sq.isChecked(),
            show_fq=self.plot_fq.isChecked(),
            show_gr=self.plot_gr.isChecked(),
            reset_axis_on_update=self.reset_axes_check.isChecked()
        )
    
    def closeEvent(self, event):
        """Handle window close event."""
        # Save settings
        self.settings.parameters = self._get_parameters()
        self.settings.file_config.current_file = self.data_file_edit.text()
        self.settings.file_config.current_bkg_file = self.bkg_file_edit.text()
        self.settings.save()
        
        logger.info("Application closing, settings saved")
        event.accept()
